/* ===== 首页样式 ===== */

/* Header */
.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 16rpx 8rpx 32rpx;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.header-icon {
  font-size: 56rpx;
}

.header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2C2419;
}

.header-subtitle {
  font-size: 22rpx;
  color: #9E8E80;
  margin-top: 4rpx;
}

.header-right {
  text-align: right;
}

.temp-display {
  font-size: 40rpx;
  font-weight: 700;
  color: #8B5E34;
}

.update-time {
  font-size: 22rpx;
  color: #9E8E80;
  display: block;
}

.connect-status {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 22rpx;
  color: #9E8E80;
  margin-top: 4rpx;
}

/* 综合舒适度卡片 */
.comfort-card {
  border: 2rpx solid;
  padding: 28rpx;
}

.comfort-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.comfort-icon {
  font-size: 32rpx;
}

.comfort-title {
  font-size: 30rpx;
  font-weight: 600;
  flex: 1;
}

.comfort-badge {
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  gap: 8rpx;
}

/* 环形进度 */
.rings-row {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.ring-item {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 150rpx;
  height: 150rpx;
}

.ring-labels {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1;
}

.ring-value {
  font-size: 26rpx;
  font-weight: 700;
  color: #2C2419;
}

.ring-unit {
  font-size: 22rpx;
  color: #9E8E80;
}

.ring-name {
  font-size: 24rpx;
  color: #9E8E80;
  margin-top: 4rpx;
}

/* 详细数据 */
.detail-card {
  padding: 8rpx 32rpx;
}

.detail-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
}

.detail-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.detail-icon.temp { background: #FFF5E0; }
.detail-icon.hum { background: #E8F4FD; }
.detail-icon.light { background: #FFF8E7; }

.detail-info {
  flex: 1;
}

.detail-name {
  font-size: 28rpx;
  color: #2C2419;
  font-weight: 500;
}

.detail-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.detail-value {
  font-size: 28rpx;
  color: #9E8E80;
}

.detail-status {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  gap: 8rpx;
}

.detail-divider {
  height: 1rpx;
  background: #F5EFE6;
  margin: 0 84rpx;
}

/* AI建议 */
.advice-card {
  border-left: 8rpx solid;
  padding-left: 28rpx;
}

.advice-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.advice-badge {
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  color: #FFFFFF;
}

.advice-text {
  font-size: 26rpx;
  color: #5A4E44;
  line-height: 1.8;
}

/* 设备控制 */
.control-card {
  padding: 28rpx;
}

.control-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.control-status {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #9E8E80;
  gap: 8rpx;
}

.control-grid {
  display: flex;
  gap: 20rpx;
}

.control-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 16rpx;
  border-radius: 20rpx;
  background: #F8F5F0;
  transition: all 0.2s;
}

.control-item.active {
  background: linear-gradient(135deg, #8B5E34, #A67B5B);
}

.control-item.active .control-name,
.control-item.active .control-state {
  color: #FFFFFF;
}

.control-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.control-name {
  font-size: 24rpx;
  color: #5A4E44;
  margin-bottom: 4rpx;
}

.control-state {
  font-size: 20rpx;
  color: #9E8E80;
}

/* 趋势图 */
.chart-card {
  padding: 28rpx;
}

.chart-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.chart-tabs {
  display: flex;
  gap: 12rpx;
}

.chart-tab {
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #9E8E80;
  background: #F5EFE6;
  transition: all 0.2s;
}

.chart-tab.active {
  background: #8B5E34;
  color: #FFFFFF;
}

.trend-canvas {
  width: 100%;
  height: 400rpx;
}

/* 对话 */
.chat-card {
  padding: 28rpx;
}

.chat-header {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.chat-messages {
  max-height: 500rpx;
  margin-bottom: 20rpx;
}

.msg {
  margin-bottom: 16rpx;
  display: flex;
}

.msg-ai {
  justify-content: flex-start;
}

.msg-user {
  justify-content: flex-end;
}

.msg-bubble {
  max-width: 80%;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.msg-ai .msg-bubble {
  background: #F5EFE6;
  color: #2C2419;
  border-bottom-left-radius: 4rpx;
}

.msg-user .msg-bubble {
  background: #8B5E34;
  color: #FFFFFF;
  border-bottom-right-radius: 4rpx;
}

.msg-bubble.loading {
  display: flex;
  gap: 12rpx;
  padding: 28rpx 32rpx;
}

.loading-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #9E8E80;
  animation: blink 1.4s infinite both;
}

.loading-dot:nth-child(2) { animation-delay: 0.2s; }
.loading-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes blink {
  0%, 80%, 100% { opacity: 0.3; transform: scale(0.8); }
  40% { opacity: 1; transform: scale(1); }
}

.chat-input-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  background: #F5EFE6;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
}

.chat-send {
  width: 100rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #8B5E34, #A67B5B);
  color: #FFFFFF;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
}

.quick-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.quick-tag {
  padding: 12rpx 20rpx;
  border-radius: 28rpx;
  font-size: 22rpx;
  color: #8B5E34;
  background: #F5EFE6;
  border: 1rpx solid #E8DDD0;
}

.quick-tag:active {
  background: #EBE0D2;
}
