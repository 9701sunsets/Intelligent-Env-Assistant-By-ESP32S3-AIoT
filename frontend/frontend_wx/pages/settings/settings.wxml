<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-icon">⚙</text>
    <view>
      <view class="page-title">设置</view>
      <view class="page-subtitle">设备与偏好配置</view>
    </view>
  </view>

  <!-- 设备信息卡片 -->
  <view class="card device-card" bindtap="onDeviceTap">
    <view class="section-title">📟 设备连接</view>
    <view class="device-info">
      <view class="device-icon">🌿</view>
      <view class="device-meta">
        <view class="device-name">{{deviceInfo.name}}</view>
        <view class="device-model">{{deviceInfo.firmware}} · {{deviceInfo.macAddress}}</view>
      </view>
      <view class="device-status">
        <view class="status-dot online"></view>
        <text>{{deviceInfo.status}}</text>
      </view>
    </view>

    <!-- 信号和电量 -->
    <view class="device-metrics">
      <view class="metric">
        <text class="metric-label">上次同步</text>
        <text class="metric-value">{{deviceInfo.lastSync}}</text>
      </view>
    </view>
  </view>

  <!-- 提醒设置 -->
  <view class="card settings-card">
    <view class="section-title">🔔 提醒设置</view>

    <view class="setting-row">
      <view class="setting-left">
        <text class="setting-icon">🌡</text>
        <text class="setting-name">温度异常提醒</text>
      </view>
      <switch class="setting-switch" checked="{{settings.tempAlert}}" bindchange="onSwitchChange" data-key="tempAlert" color="#8B5E34" />
    </view>
    <view class="setting-divider"></view>

    <view class="setting-row">
      <view class="setting-left">
        <text class="setting-icon">💧</text>
        <text class="setting-name">湿度异常提醒</text>
      </view>
      <switch class="setting-switch" checked="{{settings.humidityAlert}}" bindchange="onSwitchChange" data-key="humidityAlert" color="#8B5E34" />
    </view>
    <view class="setting-divider"></view>

    <view class="setting-row">
      <view class="setting-left">
        <text class="setting-icon">☀</text>
        <text class="setting-name">光照不足提醒</text>
      </view>
      <switch class="setting-switch" checked="{{settings.lightAlert}}" bindchange="onSwitchChange" data-key="lightAlert" color="#8B5E34" />
    </view>
    <view class="setting-divider"></view>

    <view class="setting-row">
      <view class="setting-left">
        <text class="setting-icon">🤖</text>
        <text class="setting-name">自动调节模式</text>
      </view>
      <switch class="setting-switch" checked="{{settings.autoMode}}" bindchange="onSwitchChange" data-key="autoMode" color="#8B5E34" />
    </view>
    <view class="setting-divider"></view>

    <view class="setting-row">
      <view class="setting-left">
        <text class="setting-icon">🔔</text>
        <text class="setting-name">通知推送</text>
      </view>
      <switch class="setting-switch" checked="{{settings.notification}}" bindchange="onSwitchChange" data-key="notification" color="#8B5E34" />
    </view>
  </view>

  <!-- 阈值设置 -->
  <view class="card settings-card">
    <view class="section-title">📊 阈值设置</view>

    <view class="setting-group">
      <view class="setting-label">温度上限 {{thresholds.tempMax}}°C</view>
      <slider min="15" max="40" value="{{thresholds.tempMax}}" bindchange="onSliderChange" data-key="tempMax" show-value activeColor="#8B5E34" />
    </view>
    <view class="setting-divider"></view>

    <view class="setting-group">
      <view class="setting-label">温度下限 {{thresholds.tempMin}}°C</view>
      <slider min="10" max="25" value="{{thresholds.tempMin}}" bindchange="onSliderChange" data-key="tempMin" show-value activeColor="#8B5E34" />
    </view>
    <view class="setting-divider"></view>

    <view class="setting-group">
      <view class="setting-label">湿度上限 {{thresholds.humidityMax}}%</view>
      <slider min="40" max="90" value="{{thresholds.humidityMax}}" bindchange="onSliderChange" data-key="humidityMax" show-value activeColor="#8B5E34" />
    </view>
    <view class="setting-divider"></view>

    <view class="setting-group">
      <view class="setting-label">湿度下限 {{thresholds.humidityMin}}%</view>
      <slider min="10" max="50" value="{{thresholds.humidityMin}}" bindchange="onSliderChange" data-key="humidityMin" show-value activeColor="#8B5E34" />
    </view>
    <view class="setting-divider"></view>

    <view class="setting-group">
      <view class="setting-label">光照上限 {{thresholds.lightMax}} lux</view>
      <slider min="100" max="1000" value="{{thresholds.lightMax}}" bindchange="onSliderChange" data-key="lightMax" show-value activeColor="#8B5E34" />
    </view>
  </view>

  <!-- 缓存清理 -->
  <view class="card">
    <view class="setting-row" bindtap="onClearCache">
      <view class="setting-left">
        <text class="setting-icon">🗑</text>
        <text class="setting-name">清除本地缓存</text>
      </view>
      <text style="color: #9E8E80; font-size: 24rpx;">></text>
    </view>
  </view>

  <!-- 关于 -->
  <view class="about">
    <text>🌿 智能环境监测助手 v2.0</text>
    <text class="about-sub">纯模拟数据模式 · 零网络请求</text>
  </view>
</view>
